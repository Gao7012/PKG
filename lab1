        private void UpdateFromHsv()
        {
            int h = (int)numericUpDownH.Value;
            int s = (int)numericUpDownS.Value;
            int v = (int)numericUpDownV.Value;

            bool warn;
            int[] rgb = HsvToRgb(h, s, v, out warn);
