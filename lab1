            panelColorView.BackColor = Color.FromArgb(rgb[0], rgb[1], rgb[2]);
        }

        private int[] RgbToCmyk(int r, int g, int b)
        {
            double rr = r / 255.0;
            double gg = g / 255.0;
            double bb = b / 255.0;

            double k = 1 - Math.Max(Math.Max(rr, gg), bb);
            if (k >= 1)
            {
                return new int[] { 0, 0, 0, 100 };
            }
            double c = (1 - rr - k) / (1 - k);
            double m = (1 - gg - k) / (1 - k);
            double y = (1 - bb - k) / (1 - k);

            int ci = (int)Math.Round(c * 100);
            int mi = (int)Math.Round(m * 100);
            int yi = (int)Math.Round(y * 100);
            int ki = (int)Math.Round(k * 100);
            return new int[] { ci, mi, yi, ki };
        }

        private int[] CmykToRgb(int c, int m, int y, int k, out bool warn)
        {
            warn = false;
            double cc = c / 100.0;
            double mm = m / 100.0;
            double yy = y / 100.0;
            double kk = k / 100.0;

            int R = (int)Math.Round(255 * (1 - Math.Min(1, cc * (1 - kk) + kk)));
            int G = (int)Math.Round(255 * (1 - Math.Min(1, mm * (1 - kk) + kk)));
            int B = (int)Math.Round(255 * (1 - Math.Min(1, yy * (1 - kk) + kk)));

            if (R < 0 || R > 255 || G < 0 || G > 255 || B < 0 || B > 255)
            {
                warn = true;
            }
            return new int[] { R, G, B };
        }

        private int[] RgbToHsv(int r, int g, int b)
        {
            double rr = r / 255.0;
            double gg = g / 255.0;
            double bb = b / 255.0;

            double max = Math.Max(Math.Max(rr, gg), bb);
            double min = Math.Min(Math.Min(rr, gg), bb);
            double delta = max - min;

            int h = 0;
            int s = 0;
            int v = (int)Math.Round(max * 100);

            if (max != 0)
            {
                s = (int)Math.Round((delta / max) * 100);
            }

            if (delta != 0)
            {
                if (max == rr)
                {
                    h = (int)Math.Round(60 * (((gg - bb) / delta) % 6));
                }
                else if (max == gg)
                {
                    h = (int)Math.Round(60 * (((bb - rr) / delta) + 2));
                }
                else
                {
                    h = (int)Math.Round(60 * (((rr - gg) / delta) + 4));
                }
            }
            if (h < 0)
            {
                h = h + 360;
            }
            return new int[] { h, s, v };
        }

        private int[] HsvToRgb(int h, int s, int v, out bool warn)
        {
            warn = false;
            double hh = h;
            double ss = s / 100.0;
            double vv = v / 100.0;

            double c = vv * ss;
            double x = c * (1 - Math.Abs((hh / 60) % 2 - 1));
            double m = vv - c;

            double R, G, B;
            if (hh >= 0 && hh < 60)
            {
                R = c; G = x; B = 0;
            }
            else if (hh >= 60 && hh < 120)
            {
                R = x; G = c; B = 0;
            }
            else if (hh >= 120 && hh < 180)
            {
                R = 0; G = c; B = x;
            }
            else if (hh >= 180 && hh < 240)
            {
                R = 0; G = x; B = c;
            }
            else if (hh >= 240 && hh < 300)
            {
                R = x; G = 0; B = c;
            }
            else
            {
                R = c; G = 0; B = x;
            }

            int r = (int)Math.Round((R + m) * 255);
            int g = (int)Math.Round((G + m) * 255);
            int b = (int)Math.Round((B + m) * 255);

            if (r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255)
            {
                warn = true;
            }
            return new int[] { r, g, b };
        }
